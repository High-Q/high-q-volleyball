{
  "name": "@high-q/root",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build:lp": "pnpm --filter @high-q/lp build",
    "dev:lp": "pnpm --filter @high-q/lp dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --grep @smoke",
    "test:e2e:ui": "playwright test --ui",
    "db:push": "supabase db push",
    "db:diff": "supabase db diff",
    "db:status": "supabase db status",
    "migrate:aws-events": "tsx scripts/migrate-aws-events-to-supabase.ts"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.33.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "core-js",
      "esbuild",
      "supabase"
    ]
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@supabase/supabase-js": "^2.45.0",
    "supabase": "^2.98.2",
    "tsx": "^4.19.0"
  }
}
