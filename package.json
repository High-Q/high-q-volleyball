{
  "name": "@high-q/root",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build:lp": "pnpm --filter @high-q/lp build",
    "dev:lp": "pnpm --filter @high-q/lp dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "stylelint": "pnpm -r --if-present stylelint",
    "depcruise": "depcruise apps/admin/src apps/reservation/src --config dependency-cruiser.config.js",
    "static-checks": "bash scripts/static-checks/run-all.sh",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:coverage": "pnpm -r --if-present test:coverage",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --grep @smoke",
    "test:e2e:ui": "playwright test --ui",
    "dev:login": "node scripts/dev/dev-login.mjs",
    "db:push": "supabase db push",
    "db:diff": "supabase db diff",
    "db:status": "supabase db status",
    "migrate:aws-events": "tsx scripts/migrate-aws-events-to-supabase.ts"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.33.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "core-js",
      "esbuild",
      "supabase"
    ],
    "overrides": {
      "form-data": ">=4.0.6 <5",
      "fast-uri": ">=3.1.4 <4",
      "js-yaml": ">=4.2.0 <5",
      "tar": ">=7.5.16 <8",
      "immutable": ">=4.3.9 <5",
      "js-cookie": ">=3.0.7 <4",
      "brace-expansion@5": ">=5.0.7 <6"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@supabase/supabase-js": "^2.45.0",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "@vitest/coverage-v8": "^2.1.9",
    "dependency-cruiser": "^17.4.3",
    "eslint": "^8.57.1",
    "eslint-import-resolver-alias": "^1.1.2",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^6.0.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-vue": "^9.33.0",
    "postcss-html": "^1.8.1",
    "stylelint": "^17.12.0",
    "stylelint-config-recommended-vue": "^1.6.1",
    "stylelint-config-standard": "^40.0.0",
    "supabase": "^2.98.2",
    "tsx": "^4.23.1",
    "vue-eslint-parser": "^9.4.3"
  }
}
