{
  "name": "@high-q/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && vue-tsc --emitDeclarationOnly -p tsconfig.build.json",
    "lint": "echo 'lint via root config' && exit 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "dependencies": {
    "@high-q/design-tokens": "workspace:*"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.2",
    "@vue/test-utils": "^2.4.8",
    "jsdom": "^25.0.0",
    "typescript": "^5.4.0",
    "vite": "^5.0.10",
    "vitest": "^2.1.9",
    "vue": "^3.4.3",
    "vue-tsc": "^2.1.10"
  }
}
